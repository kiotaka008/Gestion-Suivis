# Configuration locale du backend Gestion-Suivis — modèle à copier en « .env » (jamais commité).
#
# Chargement : lancer le backend depuis le dossier backend/ avec la variable
#   SPRING_CONFIG_IMPORT=optional:file:./.env[.properties]
# (PowerShell : $env:SPRING_CONFIG_IMPORT = "optional:file:./.env[.properties]")
# Les variables d'environnement définies explicitement restent prioritaires.

# --- Serveur ---
# Le frontend React appelle http://localhost:3000/api (VITE_API_URL de son .env.example).
server.port=3000

# --- Base PostgreSQL (schéma officiel ProjectManager_SaaS_Database, branche develop) ---
# Installation : migrations 20260930_001 puis 20261104_004, puis (en dev) le seed 20260930_002.
# Le backend ne crée ni ne modifie aucune table (ddl-auto=validate).
DB_URL=jdbc:postgresql://localhost:5432/projectmanager
# Rôle applicatif conseillé : ni superutilisateur, ni propriétaire des tables, sans BYPASSRLS,
# pour que les politiques RLS s'appliquent en plus du filtrage par organisation du backend.
DB_USERNAME=projectmanager_app
DB_PASSWORD=

# --- Sécurité ---
# Secret de signature des JWT : 32 caractères minimum (sinon secret aléatoire à chaque démarrage).
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
# true uniquement en HTTPS (production)
COOKIE_SECURE=false
# Origines CORS supplémentaires (5173 et 3000 sont toujours autorisés), séparées par des virgules
CORS_ALLOWED_ORIGINS=
# Inscription libre POST /api/auth/register (et création de compte à la 1re connexion Google)
AUTH_REGISTRATION_ENABLED=false

# --- Connexion avec Google (Google Identity Services) ---
# Identifiant client OAuth de type « Application Web » (Google Cloud Console > API et services >
# Identifiants). Origines JavaScript autorisées : http://localhost:5173. Vide = bouton Google désactivé.
GOOGLE_CLIENT_ID=

# --- Service IA (FastAPI) ---
AI_SERVICE_URL=http://127.0.0.1:8000
# Même valeur que INTERNAL_API_KEY du service IA (16 caractères minimum)
AI_INTERNAL_API_KEY=
AI_CONNECT_TIMEOUT_SECONDS=5
AI_READ_TIMEOUT_SECONDS=60
AI_HEALTH_TIMEOUT_SECONDS=3
