# ──────────────────────────────────────────────────────
# ENVIRONNEMENT
# ──────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────
# SERVEUR
# ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ──────────────────────────────────────────────────────
# SÉCURITÉ INTERNE (entre backend principal et service IA)
# Générer une clé forte : python -c "import secrets; print(secrets.token_urlsafe(48))"
# ──────────────────────────────────────────────────────
INTERNAL_API_KEY=change-me-with-a-strong-random-key

# ──────────────────────────────────────────────────────
# GROQ (fournisseur LLM utilisé par le service)
# Clé à créer sur https://console.groq.com/keys
# ──────────────────────────────────────────────────────
GROQ_API_KEY=gsk-your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Mode démo sans appel au LLM (réponses simulées) : true / false
USE_MOCK=false

# ──────────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ──────────────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30