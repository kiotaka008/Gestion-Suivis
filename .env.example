# URL de base de l'API vue par le navigateur.
# Garder « /api » : les appels passent par le proxy Vite (même origine), indispensable pour
# le cookie de session HttpOnly et le jeton CSRF.
VITE_API_URL=/api

# Adresse réelle du backend Spring Boot, utilisée par le proxy Vite (vite.config.ts).
VITE_BACKEND_URL=http://localhost:3000

# Nom de l'application
VITE_APP_NAME=ProjectManager

# La connexion avec Google se configure côté backend (GOOGLE_CLIENT_ID dans backend/.env) :
# le frontend lit l'identifiant client via GET /api/auth/google/config.
